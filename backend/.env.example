# Copiar a .env y ajustar. El .env NO se versiona.

# --- Servicio ---
NOMBRE_APP="CEDIS API"
VERSION_APP=0.1.0
DEPURAR=false

# --- Base de datos y cola ---
# PostgreSQL 16 del nodo edge (en docker-compose el host es "postgres").
URL_BASE_DATOS=postgresql+psycopg://cedis:cedis@localhost:5432/cedis
URL_REDIS=redis://localhost:6379/0

# --- Llave HMAC de las etiquetas ---
# Si se filtra, cualquiera imprime etiquetas validas. En produccion se monta
# como secreto (no en este archivo). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LLAVE_FIRMA_QR=cambiar-esta-llave-en-produccion

# --- Parametros operativos (propuesta v2) ---
ANDENES_RECIBO=4
ANDEN_FLEX=5
HORAS_OPERACION=10
HORAS_ANDEN_FLEX=5
HORAS_ANTIGUEDAD_LIMITE=36
UMBRAL_CROSS_DOCK=0.70

# --- Integracion fiscal ---
# En false se usa el stub (solo valida formato del UUID).
SAT_VALIDACION_ACTIVA=false

# --- CORS: portal de proveedores y tablero ---
ORIGENES_PERMITIDOS=["http://localhost:5173"]
